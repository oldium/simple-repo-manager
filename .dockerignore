# Only what lint, tests and the build read
*
!/package.json
!/package-lock.json
!/tsconfig.json
!/build.ts
!/eslint.config.mjs
!/jest.config.mjs
!/test-environment.mjs
!/test-matchers.ts
!/test-sequencer.cjs
!/server
!/types
!/public
!/tests
!/templates/deb.eta.html
!/templates/rpm.eta.html

# What git ignores stays out of these too
**/.DS_Store
**/.idea
**/.env*
**/env
**/.pnp.*
**/.vercel
**/*.pem
**/*.key
**/*.gpg
**/*.asc
**/*.tsbuildinfo
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
