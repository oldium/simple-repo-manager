{
  "name": "simple-repo-manager",
  "version": "2.1.1",
  "description": "A simple repository manager for both Debian and RedHat repository formats",
  "author": "Oldřich Jedlička",
  "license": "BSD-2-Clause",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file=env.development --enable-source-maps ./server/server.ts",
    "build": "node ./node_modules/typescript7/bin/tsc --project ./tsconfig.json && node --enable-source-maps ./build.ts",
    "test": "node --enable-source-maps --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --colors",
    "test:debug": "node --enable-source-maps --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --colors --detectOpenHandles --runInBand",
    "lint": "eslint",
    "prod": "node --env-file=env.production --enable-source-maps ./dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/console": "^30.5.2",
    "@jest/globals": "^30.5.2",
    "@jest/test-sequencer": "^30.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/escape-html": "^1.0.4",
    "@types/etag": "^1.8.4",
    "@types/express": "^5.0.6",
    "@types/finalhandler": "^1.2.4",
    "@types/fresh": "^0.5.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.12.2",
    "@types/parseurl": "^1.3.3",
    "@types/proxy-addr": "^2.0.3",
    "@types/serve-index": "^1.9.4",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^7.2.1",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^11.0.0",
    "cheerio": "^1.2.0",
    "debug-stream": "^3.0.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jest-util": "^30.5.1",
    "postcss": "^8.5.31",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@colors/colors": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "dedent": "^1.7.2",
    "dotenv": "^18.0.9",
    "entities": "^8.1.0",
    "escape-html": "^1.0.3",
    "eta": "^4.6.0",
    "etag": "^1.8.1",
    "express": "^5.3.0",
    "fast-glob": "^3.3.3",
    "finalhandler": "^2.1.1",
    "fresh": "^2.0.0",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "openpgp": "^6.3.2",
    "parseurl": "^1.3.3",
    "pretty-bytes": "^7.2.0",
    "proxy-addr": "^2.0.8",
    "selfsigned": "^5.5.0",
    "serve-index": "^1.9.2",
    "serve-static": "^2.2.1",
    "shell-quote": "^1.12.0",
    "tiny-typed-emitter": "^2.1.0",
    "tmp-promise": "^3.0.3",
    "untildify": "^6.0.0",
    "winston": "^3.19.0",
    "with-local-tmp-dir": "^7.0.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
